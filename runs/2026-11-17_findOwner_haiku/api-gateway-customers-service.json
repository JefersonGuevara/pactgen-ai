                  "id": 1,
                  "name": "cat"
                }
              }
            ],
            "telephone": "5551234567"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.address": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.city": {
              "combine": "AND",
